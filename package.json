{
  "name": "conecta-saude-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm ci --prefix backend --include=dev && npm run build --prefix backend",
    "start": "cd backend && npm start",
    "deploy:slides": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy_slides.ps1",
    "deploy:app": "firebase deploy --only hosting:conecta-hospital"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_background_on">

    <!-- Ícone de Maleta / Trabalho -->
    <ImageView
        android:id="@+id/widget_status_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_notification"
        android:tint="#FFFFFF"
        android:scaleType="fitCenter" />

    <!-- Label de Status Compacto -->
    <TextView
        android:id="@+id/widget_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EM SERVIÇO"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="3dp"
        android:maxLines="1" />

</LinearLayout>
